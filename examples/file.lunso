import std.file
import std.mem

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 4096) < 0 {
        return 1
    }

    var input: file.Bytes
    var count = file.read_all("input.txt", &arena, &input)
    if count >= 0 {
        count = file.write_all("output.txt", input.ptr[0..input.len])
    }
    var released = mem.deinit(&arena)
    if count < 0 || released < 0 {
        return 1
    }
    return 0
}
