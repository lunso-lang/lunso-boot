ext fun read(fd: i32, buffer: *u8, capacity: u64): i64
ext fun putchar(character: i32): i32

fun main(): i32 {
    var buffer: [4096]u8
    var size: i64 = read(0, &buffer[0], len(buffer) as u64)

    for ; size > 0; size = read(0, &buffer[0], len(buffer) as u64) {
        var source: []u8 = buffer[0..size]
        for var i: i64 = 0; i < len(source); i += 1 {
            putchar(source[i] as i32)
        }
    }

    if size < 0 {
        return 1
    }
    return 0
}
